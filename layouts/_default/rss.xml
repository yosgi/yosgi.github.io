{{- $isHome := .IsHome -}}
{{- $pages := .RegularPages -}}
{{- if $isHome -}}
  {{- $pages = where .Site.RegularPages "Section" "post" -}}
{{- end -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = first $limit $pages -}}
{{- end -}}
{{- $title := .Title -}}
{{- if and $isHome (eq $title "") -}}
  {{- $title = .Site.Title -}}
{{- end -}}
{{- if and (ne $title .Site.Title) (not $isHome) -}}
  {{- $title = printf "%s on %s" $title .Site.Title -}}
{{- end -}}
{{- $description := .Description -}}
{{- $baseURL := .Site.Params.rssBaseURL | default .Site.BaseURL -}}
{{- if eq $description "" -}}
  {{- if $isHome -}}
    {{- $description = printf "Recent content on %s" .Site.Title -}}
  {{- else -}}
    {{- $description = printf "Recent content in %s on %s" .Title .Site.Title -}}
  {{- end -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ printf "%s%s" $baseURL (strings.TrimPrefix "/" .RelPermalink) }}</link>
    <description>{{ $description }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.Language.Lang }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{ with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ printf "%s%s" $baseURL (strings.TrimPrefix "/" .RelPermalink) }}" rel="self" type="{{ .MediaType.Type }}" />
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ printf "%s%s" $baseURL (strings.TrimPrefix "/" .RelPermalink) }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ printf "%s%s" $baseURL (strings.TrimPrefix "/" .RelPermalink) }}</guid>
      {{- $summary := "" -}}
      {{- if .Params.description -}}
        {{- $summary = .Params.description | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
      {{- else if .Params.summary -}}
        {{- $summary = .Params.summary | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
      {{- else -}}
        {{- $summary = .Summary | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
      {{- end -}}
      {{- with $summary }}
      <description>{{ . }}</description>
      {{- end }}
    </item>
    {{ end }}
  </channel>
</rss>
