{
  "name": "yosgi-hugo-blog",
  "version": "1.0.0",
  "description": "Hugo blog with Obsidian-first local Markdown authoring",
  "main": "scripts/new-post.js",
  "scripts": {
    "dev": "hugo server -D",
    "build": "hugo --minify",
    "new:zh": "node scripts/new-post.js --lang zh",
    "new:en": "node scripts/new-post.js --lang en",
    "sync:icloud": "zsh scripts/sync-icloud-to-repo.sh",
    "sync:icloud:dry-run": "zsh scripts/sync-icloud-to-repo.sh --dry-run",
    "publish:icloud": "zsh scripts/publish-icloud.sh",
    "sync:legacy": "node scripts/notion-to-md-sync.js",
    "sync:legacy:clear-cache": "node scripts/notion-to-md-sync.js --clear-cache",
    "sync:legacy:help": "node scripts/notion-to-md-sync.js --help",
    "sync:legacy:dry-run": "node scripts/notion-to-md-sync.js --dry-run"
  },
  "keywords": [
    "obsidian",
    "hugo",
    "blog",
    "markdown",
    "publishing"
  ],
  "author": "Yosgi",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.2.3",
    "notion-to-md": "^2.6.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/your-hugo-blog.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/your-hugo-blog/issues"
  },
  "homepage": "https://github.com/your-username/your-hugo-blog#readme"
}
