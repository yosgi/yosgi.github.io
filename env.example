# Local environment variables
# Copy this file to .env when needed.

# Google Translate helper
GOOGLE_API_KEY=your_google_translate_api_key

# Optional iCloud Obsidian vault path
ICLOUD_VAULT_DIR="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/yosgi-blog-vault"

# Optional Hugo overrides
HUGO_CONTENT_DIR=./content
HUGO_POST_DIR=post
